// TirePro CRM — Prisma schema
// B2B inside sales management for tire / wheel / trailer parts wholesale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MANAGER
  SALES_REP
  ACCOUNTING
}

enum CustomerType {
  TIRE_SHOP
  CAR_DEALER
  TRAILER_MANUFACTURER
  FLEET
  REPAIR_SHOP
  WHOLESALE_DEALER
  ONLINE_BUYER
  OTHER
}

enum CustomerStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  LOST
  DO_NOT_CONTACT
}

enum CustomerSource {
  GOOGLE
  FACEBOOK
  REFERRAL
  WALK_IN
  EXISTING
  COLD_CALL
  WEBSITE
  MARKETPLACE
  WEBSITE_QUOTE
  WEBSITE_DEALER_APP
  AI_ASSISTANT
  CONSUMER_REFERRAL
  PROSPECTING
  OTHER
}

enum ProductCategory {
  PCR_TIRES
  LT_TIRES
  TBR_TIRES
  TRAILER_TIRES
  WHEELS
  TRAILER_PARTS
  OIL_LUBRICANTS
  OTHER
}

enum Tier {
  A
  B
  C
  D
}

enum PipelineStage {
  NEW_LEAD
  CONTACTED
  INTERESTED
  QUOTED
  NEGOTIATING
  FIRST_ORDER
  ACTIVE_CUSTOMER
  LOST
}

enum LostReason {
  PRICE_TOO_HIGH
  NO_RESPONSE
  BOUGHT_FROM_COMPETITOR
  NO_CURRENT_DEMAND
  BAD_CREDIT
  WRONG_CUSTOMER_TYPE
  OTHER
}

enum ProspectPool {
  A_BUYER    // direct buyer — can enter auto outreach once reviewed
  B_PROJECT  // OEM / big retail — project pool, first-touch only
  C_CHANNEL  // channel value unclear — manual verify
  D_EXCLUDED // protected / competitor / invalid
}

enum ProspectConfidence {
  H
  M
  L
}

enum ProspectProductLine {
  P1_TRAILER_TIRE
  P2_TRAILER_WHEEL
  P3_PCR
  P4_TBR
  P5_OTR
}

enum ExclusionKind {
  EXISTING_CUSTOMER
  AGENT
  COMPETITOR
  OPTED_OUT
  RISK
  BLACKLIST // bad credit / unpaid debt / fraud — reps must not engage (owner rule 2026-07-25)
}

enum ProspectSourceKind {
  SEED
  REVIVAL
  GOOGLE_PLACES
  WEB_SCRAPE
  CUSTOMS
}

enum ActivityType {
  CALL
  EMAIL
  TEXT
  WHATSAPP
  QUOTE
  ORDER
  PAYMENT
  VISIT
  COMPLAINT
  INTERNAL_NOTE
  NO_ANSWER
  VOICEMAIL
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELED
}

enum TaskType {
  CALL
  FOLLOW_UP
  QUOTE
  PAYMENT
  REACTIVATION
  COMPLAINT
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  FOLLOW_UP_NEEDED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum Probability {
  LOW
  MEDIUM
  HIGH
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  QUOTE_FOLLOW_UP
  CUSTOMER_NEEDS_CONTACT
  LEAD_ASSIGNED
  CHAT_MENTION
}

enum DocumentType {
  ACCOUNT_APPLICATION
  RESALE_CERTIFICATE
  DRIVER_LICENSE
  CREDIT_CARD_AUTH
  W9_FORM
  INSURANCE_CERT
  OTHER
}

enum LostSaleReason {
  NO_STOCK
  PRICE
  OTHER
}

// ---------- Models ----------

model Location {
  id        String   @id @default(cuid())
  name      String   @unique // "Rhino Tire USA"
  city      String? // "Orlando, FL"
  shortTag  String // "FL" — used in UI badges
  color     String   @default("#e8590c")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users         User[]
  customers     Customer[]
  leads         Lead[]
  quotes        Quote[]
  tasks         Task[]
  activities    Activity[]
  opportunities Opportunity[]
  orders        Order[]
  inventory     InventorySnapshot[]
  invoices      Invoice[]
  lostSales     LostSale[]
  brandConfigs  BrandConfig[]
  installers    Installer[]
  consumerLeads ConsumerLead[]
  freightShipments FreightShipment[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SALES_REP)
  active       Boolean  @default(true)
  // null for ADMIN = all locations
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers      Customer[]     @relation("AssignedCustomers")
  leads          Lead[]         @relation("AssignedLeads")
  reviewedLeads  Lead[]         @relation("ReviewedLeads")
  activities     Activity[]
  tasksAssigned  Task[]         @relation("TaskAssignee")
  tasksCreated   Task[]         @relation("TaskCreator")
  quotes         Quote[]
  opportunities  Opportunity[]
  notifications  Notification[]
  importBatches  ImportBatch[]
  documentsUploaded CustomerDocument[]
  aiUsages       AiUsage[]
  lostSales      LostSale[]
  chatMessages   ChatMessage[] @relation("ChatAuthor")
  chatReceived   ChatMessage[] @relation("ChatRecipient")
  installers     Installer[]
  consumerLeads  ConsumerLead[]
  specReviews    SpecProposal[]
  freightShipments FreightShipment[]

  // "Assistant" access: this user can also see the customers of everyone in `assists`.
  assists    User[] @relation("RepAssists")
  assistedBy User[] @relation("RepAssists")
  @@index([locationId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("ChatAuthor", fields: [userId], references: [id], onDelete: Cascade)
  recipientId String?  // null = company-wide team channel; set = 1:1 direct message
  recipient   User?    @relation("ChatRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  imagePath   String?  // attached image in the public chat-images bucket
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([recipientId, userId])
  @@index([userId])
}

model Customer {
  id             String          @id @default(cuid())
  companyName    String
  contactPerson  String?
  phone          String? // company phone
  contactCell    String?
  email          String?
  website        String?
  facebookUrl    String?
  instagramUrl   String?
  whatsapp       String?
  address        String?
  city           String?
  state          String?
  zip            String?
  type           CustomerType    @default(TIRE_SHOP)
  status         CustomerStatus  @default(LEAD)
  source         CustomerSource  @default(OTHER)
  // primary product interest + full interest list
  mainInterest   ProductCategory @default(PCR_TIRES)
  interests      ProductCategory[]
  tier           Tier            @default(C)
  creditLimit    Decimal?        @db.Decimal(12, 2)
  paymentTerms   String?
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  notes          String?
  score          Int             @default(0)

  assignedRepId String?
  assignedRep   User?   @relation("AssignedCustomers", fields: [assignedRepId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  activities    Activity[]
  tasks         Task[]
  quotes        Quote[]
  opportunities Opportunity[]
  tags          CustomerTag[]
  leads         Lead[]
  documents     CustomerDocument[]
  orders        Order[]
  invoices      Invoice[]
  lostSales     LostSale[]
  installers    Installer[]
  installerReferrals InstallerReferral[]
  dealerUsers   DealerUser[]
  dealerOrderRequests DealerOrderRequest[]

  // Placeholder fields for future Tireguru POS integration
  tireguruId     String? @unique
  externalSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedRepId])
  @@index([locationId])
  @@index([status])
  @@index([lastContactAt])
  @@index([nextFollowUpAt])
}

model Lead {
  id            String          @id @default(cuid())
  companyName   String
  contactPerson String?
  phone         String?
  email         String?
  city          String?
  state         String?
  type          CustomerType    @default(TIRE_SHOP)
  source        CustomerSource  @default(OTHER)
  interest      ProductCategory @default(PCR_TIRES)
  stage         PipelineStage   @default(NEW_LEAD)
  lostReason    LostReason?
  lostNote      String?
  notes         String?
  meta          Json? // raw website form payload (business type, volume, products, zip …)
  nextFollowUpAt DateTime?
  lastActivityAt DateTime?

  // ---- AI prospecting (spec 2026-07-24) ----
  pool        ProspectPool?
  confidence  ProspectConfidence?
  productLine ProspectProductLine?
  country     String              @default("US")
  score       Int?
  scoreReasons Json? // six-check results: [{check, pass, evidence}]
  enrichment  Json? // website extraction: emails, brandsSold, wholesale signals…
  dedupeKey   String? @unique // domain || phone || name+city (prospect-dedupe.ts)
  sourceRunId String?
  sourceRun   SourceRun? @relation(fields: [sourceRunId], references: [id])
  reviewedAt   DateTime? // calibration verdict timestamp
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedLeads", fields: [reviewedById], references: [id])
  rejectReason String?

  assignedRepId String?
  assignedRep   User?   @relation("AssignedLeads", fields: [assignedRepId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // set when the lead is converted into a customer
  convertedCustomerId String?
  convertedAt         DateTime?
  convertedCustomer   Customer? @relation(fields: [convertedCustomerId], references: [id])

  activities Activity[]
  consumerLeads ConsumerLead[]

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([assignedRepId])
  @@index([convertedCustomerId])
  @@index([importBatchId])
  @@index([locationId])
  @@index([pool, reviewedAt])
}

// Protection / suppression pool. Checked before ANY outreach — see
// packages/services/src/exclusion-service.ts. Never auto-touch a match.
model ExclusionList {
  id          String        @id @default(cuid())
  kind        ExclusionKind
  companyName String
  domain      String? // domainKey()-normalized
  phone       String? // phoneKey()-normalized (last 10 digits)
  reason      String?
  reviewAt    DateTime? // when to re-check whether exclusion still applies
  addedById   String?
  createdAt   DateTime      @default(now())

  @@index([domain])
  @@index([phone])
}

// One collection run (Places sweep, seed import, …) — cost ledger + provenance.
model SourceRun {
  id           String             @id @default(cuid())
  source       ProspectSourceKind
  params       Json // {state, category, limit, …}
  resultCount  Int                @default(0)
  newLeadCount Int                @default(0)
  dupCount     Int                @default(0)
  excludedCount Int               @default(0)
  apiCostUsd   Float              @default(0)
  inputTokens  Int                @default(0)
  outputTokens Int                @default(0)
  createdAt    DateTime           @default(now())

  leads Lead[]
}

model Activity {
  id                String       @id @default(cuid())
  type              ActivityType
  occurredAt        DateTime     @default(now())
  subject           String
  notes             String?
  outcome           String?
  meaningful        Boolean      @default(false) // real conversation vs. no answer
  followUpRequired  Boolean      @default(false)
  nextFollowUpAt    DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  repId      String
  rep        User      @relation(fields: [repId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  quoteId    String?
  quote      Quote?    @relation(fields: [quoteId], references: [id])

  createdAt DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([repId, occurredAt])
  @@index([leadId])
  @@index([locationId])
  @@index([quoteId])
}

model Task {
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  type        TaskType     @default(FOLLOW_UP)
  completedAt DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assigneeId String
  assignee   User      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId  String
  creator    User      @relation("TaskCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status, dueDate])
  @@index([creatorId])
  @@index([customerId])
  @@index([locationId])
}

model Quote {
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  id             String      @id @default(cuid())
  quoteNumber    String      @unique
  quoteDate      DateTime    @default(now())
  expirationDate DateTime?
  status         QuoteStatus @default(DRAFT)
  sentAt         DateTime?
  decidedAt      DateTime? // when ACCEPTED / REJECTED
  lastFollowUpAt DateTime?
  nextFollowUpAt DateTime?
  competitorPrice Decimal?   @db.Decimal(12, 2)
  competitorBrand String?
  total          Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  repId      String
  rep        User     @relation(fields: [repId], references: [id])

  items      QuoteItem[]
  activities Activity[]
  installerReferrals InstallerReferral[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([repId])
  @@index([customerId])
  @@index([locationId])
}

model QuoteItem {
  id          String          @id @default(cuid())
  category    ProductCategory @default(PCR_TIRES)
  description String
  sizeSku     String?
  brand       String?
  quantity    Int             @default(1)
  unitPrice   Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal         @default(0) @db.Decimal(12, 2)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  @@index([quoteId])
}

model Opportunity {
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  id                String            @id @default(cuid())
  category          ProductCategory
  estMonthlyVolume  String?
  currentSupplier   String?
  targetPrice       Decimal?          @db.Decimal(12, 2)
  competitorBrand   String?
  probability       Probability       @default(MEDIUM)
  nextAction        String?
  status            OpportunityStatus @default(OPEN)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  repId      String
  rep        User     @relation(fields: [repId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId])
  @@index([locationId])
  @@index([repId])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String        @default("#64748b")
  customers CustomerTag[]
}

// ---------- Dealer portal auth (architecture.md trust tier: external dealer) ----------
// Completely separate from internal User. A dealer login belongs to exactly one
// Customer; every portal query is scoped to that customer server-side.

model DealerUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orderRequests DealerOrderRequest[]

  @@index([customerId])
}

// Portal order intake (strangler step: order capture digitized, the ledger stays
// in TireGuru). A request is NOT a confirmed sale — it never touches Order until
// a rep confirms it, so CRM revenue reporting stays clean.

enum DealerOrderStatus {
  SUBMITTED // dealer placed it in the portal
  CONFIRMED // rep confirmed price/stock, keyed into TireGuru
  FULFILLED // shipped / picked up
  CANCELLED
}

model DealerOrderRequest {
  id            String            @id @default(cuid())
  requestNumber String            @unique // "DR-…" shown to the dealer
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealerUserId  String
  dealerUser    DealerUser        @relation(fields: [dealerUserId], references: [id])
  status        DealerOrderStatus @default(SUBMITTED)
  poNumber      String? // the dealer's own PO reference
  notes         String?
  total         Decimal           @default(0) @db.Decimal(12, 2) // indicative, at submit-time tier prices
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  items DealerOrderRequestItem[]

  @@index([customerId, createdAt])
  @@index([status])
}

model DealerOrderRequestItem {
  id          String             @id @default(cuid())
  requestId   String
  request     DealerOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?           @relation(fields: [productId], references: [id])
  sku         String
  description String
  quantity    Int
  unitPrice   Decimal            @db.Decimal(10, 2) // server-resolved tier price at submit time
  lineTotal   Decimal            @db.Decimal(12, 2)

  @@index([requestId])
  @@index([productId])
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
}

model ImportBatch {
  id         String   @id @default(cuid())
  entity     String // "customers" | "leads" | ...
  fileName   String
  rowCount   Int
  successful Int
  failed     Int
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  leads Lead[]
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}


// ---------- v2: documents, catalog, inventory, orders ----------

model CustomerDocument {
  id          String       @id @default(cuid())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        DocumentType
  fileName    String
  storagePath String // Supabase Storage object path
  fileSize    Int
  mimeType    String
  expiresAt   DateTime? // resale certificate expiration
  sensitive   Boolean      @default(false) // DRIVER_LICENSE / CREDIT_CARD_AUTH
  notes       String?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([type, expiresAt])
  @@index([uploadedById])
}

// Who may see a product outside the internal CRM. Existing rows stay INTERNAL
// so nothing leaks publicly until explicitly published.
enum Visibility {
  INTERNAL
  PUBLIC
  DEALER_ONLY
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  brand       String?
  category    ProductCategory @default(PCR_TIRES)
  rawCategory String? // original category label from import (e.g. "Specialty / ATV")
  discontinued Boolean @default(false) // marked by managers; flyer auto-pick clears these first
  imagePath   String? // product photo in Supabase Storage (public product-images bucket)
  sizeSpec    String? // "ST205/75R15"
  description String
  cost        Decimal?        @db.Decimal(10, 2)
  priceA      Decimal?        @db.Decimal(10, 2)
  priceB      Decimal?        @db.Decimal(10, 2)
  priceC      Decimal?        @db.Decimal(10, 2)
  priceD      Decimal?        @db.Decimal(10, 2)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Public-page fields (website platform; see docs/database-migration-plan.md)
  slug            String?    @unique // "st235-80r16-rhino-hd-14pr"
  name            String? // display name for public pages
  pattern         String? // tread pattern name
  visibility      Visibility @default(INTERNAL)
  msrp            Decimal?   @db.Decimal(10, 2) // optional public reference price
  countryOfOrigin String?
  warrantySummary String?
  featuresJson    Json? // bullet features for product page

  // Merchandising flags (tire-discovery Phase 0)
  bestSeller   Boolean @default(false)
  specialOffer Boolean @default(false)
  featured     Boolean @default(false)
  publishedAt  DateTime? // first time the product went PUBLIC — powers "New Arrivals"

  inventory  InventorySnapshot[]
  orderItems OrderItem[]

  tireSpec  TireSpec?
  wheelSpec WheelSpec?
  partSpec  PartSpec?
  images    ProductImage[]
  documents ProductDocument[]
  relations ProductRelation[] @relation("ProductRelations")
  relatedTo ProductRelation[] @relation("RelatedProduct")
  consumerLeads ConsumerLead[]
  specProposal  SpecProposal?
  dealerOrderItems DealerOrderRequestItem[]

  @@index([category])
  @@index([sizeSpec])
  @@index([visibility])
}

// ---------- Category-specific product attributes (1:1 satellites) ----------

model TireSpec {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  width             Int? // section width, e.g. 235 (mm)
  aspectRatio       Int? // e.g. 80
  rimDiameter       Decimal? @db.Decimal(4, 1) // 16, 16.5 …
  construction      String? // "R" radial / "D" bias
  plyRating         Int? // e.g. 14
  loadRange         String? // "E", "G" …
  loadIndex         String? // "129/125" (dual fitment kept as text)
  speedRating       String? // "M", "L" …
  position          String? // steer / drive / trailer / all-position
  application       String? // trailer, regional haul, ATV …
  treadDepth32nds   Decimal? @db.Decimal(4, 1)
  maxLoadLbs        Int?
  maxPressurePsi    Int?
  rimWidthRange     String? // "5.5-7.0"
  overallDiameterIn Decimal? @db.Decimal(5, 2)
  sectionWidthIn    Decimal? @db.Decimal(5, 2)

  // Tire-discovery attributes (Phase 0, 2026-07-13) — filled by the
  // rules/AI/review enrichment pipeline
  shoulderType         String? // closed / open / semi-open (commercial drive)
  treadType            String? // highway / all-terrain / rugged-terrain / mud-terrain / touring / rib …
  utqg                 String?
  mileageWarrantyMiles Int?
  threePMSF            Boolean @default(false) // 3-peak mountain snowflake
  smartWay             Boolean @default(false)
  regroovable          Boolean @default(false)
  retreadable          Boolean @default(false)
  runFlat              Boolean @default(false)
  evCompatible         Boolean @default(false)
  sidewallStyle        String? // BSW / RWL / OWL

  @@index([loadRange]) // highest-frequency B2B filter
  @@index([position])
  @@index([treadType])
}

model WheelSpec {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  diameterIn    Decimal? @db.Decimal(4, 1)
  widthIn       Decimal? @db.Decimal(4, 2)
  boltPattern   String? // "5x4.5", "6x5.5" — powers the trailer wheel matcher
  lugCount      Int?
  centerBoreMm  Decimal? @db.Decimal(6, 2)
  offsetMm      Int?
  backspacingIn Decimal? @db.Decimal(4, 2)
  loadRatingLbs Int?
  finish        String? // galvanized, white spoke, black mod …
  material      String? // steel / aluminum

  @@index([boltPattern]) // highest-frequency B2B filter
}

model PartSpec {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  partType           String? // hub, bearing kit, coupler, jack …
  capacity           String? // "3500 lb axle"
  dimensions         String?
  material           String?
  mountingType       String?
  compatibilityNotes String?
  certGrade          String? // e.g. DOT, grade markings
}

// ---------- Product media and relations ----------

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String // required — SEO
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
}

enum ProductDocType {
  SPEC_SHEET
  LOAD_INFLATION
  WARRANTY
  BROCHURE
}

model ProductDocument {
  id          String         @id @default(cuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        ProductDocType
  fileName    String
  storagePath String // Supabase Storage object path

  createdAt DateTime @default(now())

  @@index([productId])
}

enum ProductRelationType {
  COMPATIBLE_WHEEL
  COMPATIBLE_VALVE
  ALTERNATIVE
  ASSEMBLY_COMPONENT
}

// "Compatible wheel/valve" on product pages and the AI Tire Finder.
model ProductRelation {
  id               String              @id @default(cuid())
  productId        String
  product          Product             @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product             @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)
  type             ProductRelationType

  createdAt DateTime @default(now())

  @@unique([productId, relatedProductId, type])
  @@index([relatedProductId])
}

model InventorySnapshot {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Int
  // Incoming stock (tire-discovery Phase 0) — manually maintained in the CRM
  reservedQty Int       @default(0)
  incomingQty Int       @default(0)
  incomingEta DateTime?
  snapshotAt DateTime @default(now())

  @@unique([productId, locationId]) // full-overwrite upsert on re-import
  @@index([locationId])
}

model Order {
  id         String   @id @default(cuid())
  externalId String?  @unique // Tire Guru invoice #
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  orderDate  DateTime
  total      Decimal  @db.Decimal(12, 2)
  source     String   @default("TIREGURU_CSV")
  createdAt  DateTime @default(now())

  items OrderItem[]

  @@index([customerId, orderDate])
  @@index([locationId, orderDate])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  rawDescription String // as it appeared in the imported CSV
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)
  @@index([orderId])
  @@index([productId])
}

// Lost sales — captured from Log Activity outcomes; feeds restock/pricing intel
model LostSale {
  id              String         @id @default(cuid())
  occurredAt      DateTime       @default(now())
  reason          LostSaleReason
  item            String // size / item the customer wanted, e.g. "ST225/75R15"
  quantity        Int            @default(0)
  estValue        Decimal        @default(0) @db.Decimal(12, 2)
  competitor      String?
  competitorPrice Decimal?       @db.Decimal(10, 2)
  notes           String?
  customerName    String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  repId      String
  rep        User      @relation(fields: [repId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())

  @@index([occurredAt])
  @@index([reason])
  @@index([customerId])
  @@index([locationId])
  @@index([repId])
}

// AI call log — cost visibility (UPGRADE-PLAN Phase 7 / migration plan 5)
model AiUsage {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      String // "priority_followups" | "message_generator" | "ask" | …
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// A/R aging — open receivable invoices imported from the accounting export
model Invoice {
  id           String   @id @default(cuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String // raw name from import, kept even if unmatched
  amount       Decimal  @db.Decimal(12, 2)
  balance      Decimal  @db.Decimal(12, 2)
  dueDate     DateTime
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  source      String    @default("IMPORT")
  createdAt   DateTime  @default(now())

  @@index([dueDate])
  @@index([customerId])
  @@index([locationId])
}

// ---------- Consumer lead platform (MVP-A) — see docs/b2b-consumer-lead-platform-architecture.md ----------

enum InstallerPreferredStatus {
  OWNED // IDEAL — William's own store, always priority 1
  PREFERRED
  PARTNER
  PROSPECT
}

enum ConsumerLeadKind {
  INSTALLED_PRICE
  APPOINTMENT
  INSTALLER_NEEDED
  SEND_TO_INSTALLER
}

enum ConsumerLeadStatus {
  SUBMITTED
  INSTALLER_NEEDED
  IDEAL_ELIGIBLE
  PARTNER_MATCHED
  EXISTING_DEALER_MATCHED
  NEW_INSTALLER_PROSPECT
  POSSIBLE_DUPLICATE
  SALES_REVIEW
  INSTALLER_CONTACTED
  INSTALLER_REQUEST_OPENED
  INSTALLER_ACCEPTED
  INSTALLER_DECLINED
  AWAITING_WHOLESALE_QUOTE
  QUOTE_CREATED
  QUOTE_SENT
  ORDER_CONFIRMED
  PRODUCT_RESERVED
  INSTALLATION_REQUESTED
  INSTALLATION_SCHEDULED
  INSTALLATION_COMPLETED
  LOST
  CANCELLED
  EXPIRED
  MANUAL_ASSISTANCE_REQUIRED
}

// Logos for the tire/wheel brands we distribute (Grandforce, Miletrip …) —
// owner uploads them in CRM; the public /brands wall shows them. Keyed by the
// exact Product.brand string.
model ProductBrandLogo {
  id        String   @id @default(cuid())
  name      String   @unique
  logoPath  String // object path in the public brand-assets bucket
  updatedAt DateTime @updatedAt
}

// Web-facing brand identity per company (addendum #1/#3). Operational tenant stays Location.
model BrandConfig {
  id           String  @id @default(cuid())
  key          String  @unique // "RHINO" | "EVERFLOW"
  domain       String  @unique // "rhinotiresusa.com"
  name         String // "Rhino Tire USA"
  legalName    String
  phone        String // E.164-ish for tel: links
  phoneDisplay String
  contactEmail String? // public contact email shown on the website
  addressJson  Json?
  networkName  String // "RHINO Local Installer Network"
  logoPath     String? // brand-assets public bucket path — uploaded by the owner in the CRM
  heroImagePath String? // homepage hero banner photo (brand-assets bucket)
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([locationId])
}

model Installer {
  id         String    @id @default(cuid())
  locationId String // owning company (Location)
  location   Location  @relation(fields: [locationId], references: [id])
  customerId String? // link when the installer is an existing CRM customer (dealer)
  customer   Customer? @relation(fields: [customerId], references: [id])

  storeName String
  legalName String?
  address   String
  city      String
  state     String
  zip       String
  lat       Float?
  lng       Float?

  serviceRadiusMi Int     @default(35)
  phone           String
  email           String?
  notifyEmail     String? // where consumer-lead notifications go (front desk)
  website         String?
  hoursJson       Json? // { mon: "8:00-17:30", ... }

  passenger     Boolean @default(true)
  lightTruck    Boolean @default(true)
  trailer       Boolean @default(false)
  tbr           Boolean @default(false)
  wheels        Boolean @default(false)
  mobileService Boolean @default(false)
  maxWheelSize  Int?

  appointmentEnabled Boolean                  @default(true)
  sameDayEnabled     Boolean                  @default(false) // only true when operationally verified (spec Hook 2)
  preferredStatus    InstallerPreferredStatus @default(PROSPECT)

  assignedRepId     String?
  assignedRep       User?   @relation(fields: [assignedRepId], references: [id])
  responseScore     Int     @default(0)
  publicPageEnabled Boolean @default(false)
  active            Boolean @default(true)

  consumerLeads ConsumerLead[]
  referrals     InstallerReferral[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zip])
  @@index([locationId, active])
  @@index([assignedRepId])
  @@index([customerId])
}

model ConsumerLead {
  id        String  @id @default(cuid())
  brandKey  String // BrandConfig.key that captured the lead
  sourceUrl String?
  campaignId String?

  name             String
  phone            String
  email            String?
  zip              String
  vehicleJson      Json?
  preferredContact String    @default("phone")
  preferredDate    DateTime?
  message          String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  tireSize  String?
  quantity  Int      @default(4)

  kind   ConsumerLeadKind
  status ConsumerLeadStatus @default(SUBMITTED)

  installerId   String?
  installer     Installer? @relation(fields: [installerId], references: [id])
  locationId    String?
  location      Location?  @relation(fields: [locationId], references: [id])
  assignedRepId String?
  assignedRep   User?      @relation(fields: [assignedRepId], references: [id])

  consumerToken String  @unique // consumer status-page capability; never a sequential id
  crmLeadId     String? // bridge: B2B Lead created when this becomes a dealer prospect
  crmLead       Lead?   @relation(fields: [crmLeadId], references: [id])

  consents      ConsumerConsent[]
  statusHistory ReferralStatusHistory[]
  referral      InstallerReferral?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([zip])
  @@index([brandKey, createdAt])
  @@index([assignedRepId])
  @@index([crmLeadId])
  @@index([installerId])
  @@index([locationId])
  @@index([productId])
}

// Proof of consumer contact consent (TCPA groundwork — SMS ships Phase 2)
model ConsumerConsent {
  id             String       @id @default(cuid())
  consumerLeadId String
  consumerLead   ConsumerLead @relation(fields: [consumerLeadId], references: [id], onDelete: Cascade)
  kind           String       @default("CONTACT") // CONTACT | SMS
  textShown      String
  ip             String
  createdAt      DateTime     @default(now())

  @@index([consumerLeadId])
}

model ReferralStatusHistory {
  id             String       @id @default(cuid())
  consumerLeadId String
  consumerLead   ConsumerLead @relation(fields: [consumerLeadId], references: [id], onDelete: Cascade)
  fromStatus     String?
  toStatus       String
  actor          String // "system" | "consumer" | "installer" | userId
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([consumerLeadId, createdAt])
}

// Server-side event log powering spec §23 BI reports (no PII in meta)
model AnalyticsEvent {
  id             String   @id @default(cuid())
  event          String
  brandKey       String?
  zip            String?
  productId      String?
  consumerLeadId String?
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([event, createdAt])
  @@index([zip])
}

// ---------- Send This Tire to My Installer (MVP-B) ----------

enum ReferralMatchStatus {
  EXISTING_DEALER // matched a CRM Customer
  EXISTING_INSTALLER // matched an Installer record
  POSSIBLE_DUPLICATE // similar but not certain — Sales Review, never silent creation
  NEW_PROSPECT
}

enum ReferralStatus {
  PENDING // created, outreach not confirmed yet
  CONTACTED
  OPENED // installer opened the secure page
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
}

model InstallerReferral {
  id             String       @id @default(cuid())
  consumerLeadId String       @unique
  consumerLead   ConsumerLead @relation(fields: [consumerLeadId], references: [id], onDelete: Cascade)

  // raw installer info as the consumer typed it — kept even after matching
  rawName    String?
  rawPhone   String?
  rawAddress String?
  rawZip     String?
  rawWebsite String?

  matchStatus       ReferralMatchStatus
  matchedCustomerId String?
  matchedCustomer   Customer? @relation(fields: [matchedCustomerId], references: [id])
  installerId       String?
  installer         Installer? @relation(fields: [installerId], references: [id])

  secureToken String   @unique // installer capability URL — 256-bit random
  expiresAt   DateTime // owner decision: 14 days
  status      ReferralStatus @default(PENDING)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  contactedAt DateTime?
  openedAt    DateTime?
  acceptedAt  DateTime?
  declinedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([installerId])
  @@index([matchedCustomerId])
  @@index([quoteId])
}

// Knowledge Center articles — owner-publishable from the CRM (spec §22 GEO rules)
model Article {
  id          String  @id @default(cuid())
  brandKey    String  @default("RHINO")
  slug        String  @unique
  title       String
  description String // meta description (<=155 chars recommended)
  answer      String // GEO: 2-3 sentence direct answer shown first
  bodyMd      String // Markdown body (tables supported)
  author      String  @default("Rhino Tire USA Wholesale Team")
  reviewedBy  String?
  published   Boolean @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandKey, published, publishedAt])
}

// ---------- Spec enrichment pipeline (tire-discovery Phase 0) ----------

enum SpecProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

// AI-extracted spec attributes wait HERE until a human approves them in the
// CRM Spec Review queue. Rule-derived facts (size math, PR→LR table) write
// straight to TireSpec; AI inferences never reach the public site unreviewed.
model SpecProposal {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // { loadRange: { value: "E", confidence: "high" }, ... } — proposed fields only
  fieldsJson Json
  status     SpecProposalStatus @default(PENDING)

  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation(fields: [reviewedById], references: [id])

  @@index([status])
  @@index([reviewedById])
}

// ---------------- Freight quoting (docs/superpowers/specs/2026-07-25-freight-quote-tool-design.md) ----------------

enum FreightEquipment {
  DRY_VAN_53
  FLATBED_53
}

enum FreightShipmentStatus {
  QUOTING
  BOOKED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum FreightQuoteStatus {
  SENT
  QUOTED
  DECLINED
  NEEDS_ATTENTION
  SEND_FAILED
}

model FreightCarrier {
  id             String             @id @default(cuid())
  name           String
  phone          String?
  mcNumber       String?
  equipmentTypes FreightEquipment[]
  notes          String?
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())

  contacts FreightCarrierContact[]
  quotes   FreightQuote[]
}

model FreightCarrierContact {
  id        String         @id @default(cuid())
  carrierId String
  carrier   FreightCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  name      String?
  email     String
  active    Boolean        @default(true)

  @@index([carrierId])
  @@index([email])
}

model FreightConsignee {
  id            String   @id @default(cuid())
  name          String // "Pearson GA – XXX Tire"
  addressLine   String
  city          String
  state         String
  zip           String
  contactName   String?
  phone         String?
  deliveryNotes String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  stops FreightShipmentStop[]
}

model FreightShipment {
  id                 String                @id @default(cuid())
  refCode            String                @unique // RT-2607-001
  originAddress      String
  originLabel        String                @default("Orlando, FL") // for email subject
  equipmentType      FreightEquipment
  pickupDate         DateTime
  commodity          String                @default("tires")
  notes              String?
  status             FreightShipmentStatus @default(QUOTING)
  awardedQuoteId     String?               @unique // FreightQuote.id, no FK to avoid relation cycle
  confirmationSentAt DateTime?
  locationId         String?
  location           Location?             @relation(fields: [locationId], references: [id])
  createdById        String
  createdBy          User                  @relation(fields: [createdById], references: [id])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  stops  FreightShipmentStop[]
  quotes FreightQuote[]

  @@index([status])
  @@index([locationId])
}

model FreightShipmentStop {
  id          String           @id @default(cuid())
  shipmentId  String
  shipment    FreightShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sequence    Int // 1..N drop order (user-specified)
  consigneeId String
  consignee   FreightConsignee @relation(fields: [consigneeId], references: [id])
  quantity    String? // free text: "250 tires / 4,800 lbs"
  notes       String?

  @@unique([shipmentId, sequence])
  @@index([consigneeId])
}

model FreightQuote {
  id              String             @id @default(cuid())
  shipmentId      String
  shipment        FreightShipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrierId       String
  carrier         FreightCarrier     @relation(fields: [carrierId], references: [id])
  status          FreightQuoteStatus @default(SENT)
  price           Decimal?           @db.Decimal(10, 2)
  transitDays     Int?
  notes           String?
  rawReplyExcerpt String?
  parsedByAi      Boolean            @default(false)
  sentAt          DateTime?
  repliedAt       DateTime?
  lastError       String?

  @@unique([shipmentId, carrierId])
  @@index([status])
}
