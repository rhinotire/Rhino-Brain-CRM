{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "SUPABASE_*",
        "BRAND_KEY",
        "SESSION_SECRET",
        "DEALER_SESSION_SECRET",
        "ZOHO_SMTP_*",
        "CRON_SECRET",
        "ANTHROPIC_API_KEY",
        "SHOPIFY_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    }
  }
}
